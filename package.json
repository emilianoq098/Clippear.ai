{
  "name": "clipper-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env node_modules/turbo/bin/turbo run dev",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check:structure": "node tools/check-structure.mjs"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
